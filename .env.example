# ── Supabase (base de datos + auth) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Autenticación ─────────────────────────────────────────────────────────────
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# OBLIGATORIA desde la separación en repos. Antes este server servía también el
# frontend, así que todo era mismo origen. Ahora la app, el panel y el sitio
# llegan desde otros orígenes. Lista separada por comas; incluir la APK.
# Ej: https://app.urbont.com,https://admin.urbont.com,https://urbont.com,capacitor://localhost
ALLOWED_ORIGIN=

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=5000

# ── Mapas ─────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Pagos — Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Stripe Dashboard → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# ── SMS — Twilio ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
# Alternativa a Resend — dejar vacío si se usa Resend
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Push ──────────────────────────────────────────────────────────────────────
# Firebase Console → Configuración → Cuentas de servicio → Generar clave (JSON en una línea)
FIREBASE_SERVICE_ACCOUNT=
# Web Push VAPID — distinto del VAPID de FCM
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Redis (opcional) ──────────────────────────────────────────────────────────
# Necesario solo para correr varias instancias: adapta Socket.IO entre ellas.
REDIS_URL=

# ── Servicios externos ────────────────────────────────────────────────────────
# Clave de Groq Cloud (gsk_*) — se llama GROK_API_KEY por compatibilidad
GROK_API_KEY=
AVIATION_STACK_KEY=

# ── Observabilidad (opcional) ─────────────────────────────────────────────────
SENTRY_DSN=
